// 验证 Backtest 2.00.18.11 明确拒绝 BOOL 类型扩展列。

config = dict(STRING, ANY)
config["startDate"] = 2025.01.02
config["endDate"] = 2025.01.03
config["strategyGroup"] = "stock"
config["cash"] = double(100000)
config["dataType"] = int(4)
config["msgAsTable"] = true
config["matchingMode"] = int(2)

def boolInitialize(mutable context) {
    return NULL
}

def boolBeforeTrading(mutable context) {
    return NULL
}

def boolOnBar(mutable context, msg, indicator) {
    return NULL
}

def boolOnSnapshot(mutable context, msg, indicator) {
    return NULL
}

def boolOnOrder(mutable context, order) {
    return NULL
}

def boolOnTrade(mutable context, trade) {
    return NULL
}

def boolAfterTrading(mutable context) {
    return NULL
}

def boolFinalize(mutable context) {
    return NULL
}

tradeTimes = temporalAdd(
    timestamp([2025.01.02, 2025.01.03]),
    15,
    "h"
)

quotation = table(
    symbol(take("000001.XSHE", 2)) as symbol,
    tradeTimes as tradeTime,
    double([10.0, 10.5]) as open,
    double([9.0, 9.5]) as low,
    double([11.0, 11.5]) as high,
    double([10.5, 11.0]) as close,
    long([1000, 1100]) as volume,
    double([11.0, 11.5]) as upLimitPrice,
    double([9.0, 9.5]) as downLimitPrice,
    double([9.8, 10.5]) as prevClosePrice,
    bool([true, false]) as selected
)

testEngine = Backtest::createBacktestEngine(
    testEngineName,
    config,
    ,
    boolInitialize,
    boolBeforeTrading,
    boolOnBar,
    boolOnSnapshot,
    boolOnOrder,
    boolOnTrade,
    boolAfterTrading,
    boolFinalize
)

Backtest::appendQuotationMsg(testEngine, quotation)
