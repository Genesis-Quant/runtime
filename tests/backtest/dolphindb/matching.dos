// 验证日频开盘撮合、买卖回调、手续费、印花税和最终权益。

config = dict(STRING, ANY)
config["startDate"] = 2025.01.02
config["endDate"] = 2025.01.07
config["strategyGroup"] = "stock"
config["cash"] = double(100000)
config["commission"] = double(0.001)
config["tax"] = double(0.002)
config["dataType"] = int(4)
config["msgAsTable"] = true
config["matchingMode"] = int(2)
config["outputOrderInfo"] = true

def matchingInitialize(mutable context) {
    context["onBarCount"] = 0
    context["onOrderCount"] = 0
    context["onTradeCount"] = 0
    context["trace"] = ["initialize"]
}

def matchingBeforeTrading(mutable context) {
    context["trace"].append!("beforeTrading")
}

def matchingOnBar(mutable context, msg, indicator) {
    context["onBarCount"] += 1
    context["trace"].append!("onBar")
    symbol = msg.symbol[0]
    if (context["onBarCount"] == 1) {
        portfolio = Backtest::getStockTotalPortfolios(context.engine)
        context["portfolioType"] = typestr(portfolio)
        context["initialTotalEquity"] = portfolio.totalEquity[0]
        Backtest::submitOrder(
            context.engine,
            (symbol, context.tradeTime, 0, msg.close[0], long(100), 1),
            "pure-buy"
        )
    } else if (context["onBarCount"] == 2) {
        Backtest::submitOrder(
            context.engine,
            (symbol, context.tradeTime, 0, msg.close[0], long(100), 3),
            "pure-sell"
        )
    }
}

def matchingOnSnapshot(mutable context, msg, indicator) {
    return NULL
}

def matchingOnOrder(mutable context, order) {
    context["onOrderCount"] += 1
    context["orderType"] = typestr(order)
    context["trace"].append!("onOrder")
}

def matchingOnTrade(mutable context, trade) {
    context["onTradeCount"] += 1
    context["tradeType"] = typestr(trade)
    context["trace"].append!("onTrade")
}

def matchingAfterTrading(mutable context) {
    context["trace"].append!("afterTrading")
}

def matchingFinalize(mutable context) {
    context["trace"].append!("finalize")
}

tradeTimes = temporalAdd(
    timestamp([2025.01.02, 2025.01.03, 2025.01.06, 2025.01.07]),
    15,
    "h"
)

quotation = table(
    symbol(take("000001.XSHE", 4)) as symbol,
    tradeTimes as tradeTime,
    double([10.0, 12.0, 14.0, 16.0]) as open,
    double([9.0, 11.0, 13.0, 15.0]) as low,
    double([12.0, 14.0, 16.0, 18.0]) as high,
    double([11.0, 13.0, 15.0, 17.0]) as close,
    long([10000, 10000, 10000, 10000]) as volume,
    double([12.0, 14.0, 16.0, 18.0]) as upLimitPrice,
    double([8.0, 10.0, 12.0, 14.0]) as downLimitPrice,
    double([9.5, 11.0, 13.0, 15.0]) as prevClosePrice
)

testEngine = Backtest::createBacktestEngine(
    testEngineName,
    config,
    ,
    matchingInitialize,
    matchingBeforeTrading,
    matchingOnBar,
    matchingOnSnapshot,
    matchingOnOrder,
    matchingOnTrade,
    matchingAfterTrading,
    matchingFinalize
)

Backtest::appendQuotationMsg(testEngine, quotation)
Backtest::appendEndMarker(testEngine)
