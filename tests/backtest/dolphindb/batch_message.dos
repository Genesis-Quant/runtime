// 验证 msgAsTable=true 时，同一时间戳的多股票以一张表进入 onBar。

config = dict(STRING, ANY)
config["startDate"] = 2025.01.02
config["endDate"] = 2025.01.06
config["strategyGroup"] = "stock"
config["cash"] = double(100000)
config["dataType"] = int(4)
config["msgAsTable"] = true
config["matchingMode"] = int(2)

def batchInitialize(mutable context) {
    context["beforeTradingCount"] = 0
    context["onBarCount"] = 0
    context["afterTradingCount"] = 0
    context["rowCounts"] = array(INT, 0)
    context["barTimes"] = array(TIMESTAMP, 0)
}

def batchBeforeTrading(mutable context) {
    context["beforeTradingCount"] += 1
}

def batchOnBar(mutable context, msg, indicator) {
    context["onBarCount"] += 1
    context["rowCounts"].append!(take(int(msg.rows()), 1))
    context["barTimes"].append!(take(msg.tradeTime[0], 1))
    if (context["onBarCount"] == 1) {
        context["firstSymbols"] = string(msg.symbol)
        context["firstSelections"] = array(INT, 0).append!(msg.selected)
        context["firstScores"] = array(DOUBLE, 0).append!(msg.score)
        context["scoreReference"] = msg.score
    }
}

def batchOnSnapshot(mutable context, msg, indicator) {
    return NULL
}

def batchOnOrder(mutable context, order) {
    return NULL
}

def batchOnTrade(mutable context, trade) {
    return NULL
}

def batchAfterTrading(mutable context) {
    context["afterTradingCount"] += 1
}

def batchFinalize(mutable context) {
    return NULL
}

tradeTimes = temporalAdd(
    timestamp([
        2025.01.02, 2025.01.02,
        2025.01.03, 2025.01.03,
        2025.01.06, 2025.01.06
    ]),
    15,
    "h"
)

quotation = table(
    symbol([
        "000001.XSHE", "600000.XSHG",
        "000001.XSHE", "600000.XSHG",
        "000001.XSHE", "600000.XSHG"
    ]) as symbol,
    tradeTimes as tradeTime,
    double([10.0, 20.0, 10.5, 20.5, 11.0, 21.0]) as open,
    double([9.0, 19.0, 9.5, 19.5, 10.0, 20.0]) as low,
    double([11.0, 21.0, 11.5, 21.5, 12.0, 22.0]) as high,
    double([10.5, 20.5, 11.0, 21.0, 11.5, 21.5]) as close,
    long([1000, 2000, 1100, 2100, 1200, 2200]) as volume,
    double([11.0, 22.0, 11.5, 22.5, 12.0, 23.0]) as upLimitPrice,
    double([9.0, 18.0, 9.5, 18.5, 10.0, 19.0]) as downLimitPrice,
    double([9.8, 19.8, 10.5, 20.5, 11.0, 21.0]) as prevClosePrice,
    int([1, 0, 0, 1, 1, 1]) as selected,
    double([0.8, 0.2, 0.3, 0.7, 0.6, 0.4]) as score
)
quotation.sortBy!(`tradeTime`symbol)

testEngine = Backtest::createBacktestEngine(
    testEngineName,
    config,
    ,
    batchInitialize,
    batchBeforeTrading,
    batchOnBar,
    batchOnSnapshot,
    batchOnOrder,
    batchOnTrade,
    batchAfterTrading,
    batchFinalize
)

Backtest::appendQuotationMsg(testEngine, quotation)
Backtest::appendEndMarker(testEngine)
