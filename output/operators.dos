    }
    if (op == "unary.expm1") {
        return direct_unary_expm1(fields["col"])
    }
    if (op == "unary.floor") {
        return direct_unary_floor(fields["col"])
    }
    if (op == "unary.get") {
        return direct_unary_get(fields["col"])
    }
    if (op == "unary.is_finite") {
        return direct_unary_is_finite(fields["col"])
    }
    if (op == "unary.is_month_end") {
