    --------
    >>> first = 1.0 2.0 3.0
    >>> second = 10.0 20.0 30.0
    >>> first[1] = NULL
    >>> second[2] = NULL
    >>> cols = array(ANY, 0)
    >>> cols.append!(first)
    >>> cols.append!(second)
    >>> direct_multiary_count(cols)
    [2, 1, 1]
    */
    return unifiedCall(rowCount, cols)
}

