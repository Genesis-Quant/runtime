    >>> high = close + 0.6
    >>> low = close - 0.5

    time_period=2：
    >>> tail(ts_talib_cci(high, low, close, 2), 3)
    [66.6667, 66.6667, -66.6667]

    time_period=3：
    >>> tail(ts_talib_cci(high, low, close, 3), 3)
    [87.5, 84.6154, -20]

    time_period=5：
    >>> tail(ts_talib_cci(high, low, close, 5), 3)
    [105.263, 119.048, 45.977]
    */
    return ta::cci(high, low, close, int(time_period))
}

