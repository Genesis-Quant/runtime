    }
    if (op == "unary.atan") {
        return direct_unary_atan(fields["col"])
    }
    if (op == "unary.between") {
        return direct_unary_between(fields["col"], params["lower"], params["upper"], params["inclusive"])
    }
    if (op == "unary.cast") {
